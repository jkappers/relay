# Postgres from docker-compose.yml
DATABASE_URL=postgres://relay:relay@localhost:54329/relay

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RELAY_MASTER_KEY=

# Server
PORT=3000
# Public HTTPS URL Slack can reach. Used to build the OAuth redirect_uri.
PUBLIC_URL=https://relay.example.com

# Console sign-up: closed (default, accounts come from the users:create CLI) or open (anyone can sign up).
# SIGNUP_MODE=closed

# Slack app (Basic Information page). Optional: Slack is on only when all three are set.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional. Comma-separated Slack user IDs allowed to connect through OAuth. Unset means any Slack user.
# SLACK_ALLOWED_USER_IDS=U0123456789

# Slack Web API base (change only for tests). Server and worker.
# SLACK_API_BASE_URL=https://slack.com/api

# Twilio API base (change only for tests). Server and worker.
# SMS_API_BASE_URL=https://api.twilio.com

# Discord app. Optional: the install button shows only when the client ID and secret are set.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Bot page. Server, worker, and gateway. One token for every Discord connection.
# DISCORD_BOT_TOKEN=
# Optional. Comma-separated Discord user IDs allowed to install the bot. Unset means anyone.
# DISCORD_ALLOWED_USER_IDS=
# Discord REST base (change only for tests). Server and worker.
# DISCORD_API_BASE_URL=https://discord.com/api/v10

# Discord gateway (pnpm dev:gateway)
# GATEWAY_METRICS_PORT=9466
# GATEWAY_LOCK_POLL_SECONDS=15

# Worker
# The worker also needs PUBLIC_URL (above): it puts $PUBLIC_URL/actions in each envelope.
# REPLY_TOKEN_TTL_SECONDS=3600
# WORKER_METRICS_PORT=9465
# Delivery retry backoff (ms). Defaults: 5000 base, 900000 (15 min) cap.
# DISPATCH_BACKOFF_BASE_MS=5000
# DISPATCH_BACKOFF_CAP_MS=900000
# WORKER_POLL_SECONDS=2

# Agent destinations (worker). The key is only needed if you create agent destinations.
# ANTHROPIC_API_KEY=
# AGENT_CONCURRENCY=1
# AGENT_BACKOFF_BASE_MS=15000
# AGENT_BACKOFF_CAP_MS=300000
# Tests and demos only. Posts a canned reply, no API call. Refused when NODE_ENV=production.
# RELAY_AGENT_RUNNER=fake

# Tests only. Defaults to the relay_test database in compose.
# TEST_DATABASE_URL=postgres://relay:relay@localhost:54329/relay_test
