# Postgres from docker-compose.yml
DATABASE_URL=postgres://relay:relay@localhost:54329/relay

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RELAY_MASTER_KEY=

# Server
PORT=3000
# Public HTTPS URL Slack can reach. Used to build the OAuth redirect_uri.
PUBLIC_URL=https://relay.example.com

# Slack app (Basic Information page)
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Comma-separated Slack user IDs allowed to connect through OAuth. Required, must not be empty.
SLACK_ALLOWED_USER_IDS=U0123456789

# Slack Web API base (change only for tests). Server and worker.
# SLACK_API_BASE_URL=https://slack.com/api

# Worker
# The worker also needs PUBLIC_URL (above): it puts $PUBLIC_URL/actions in each envelope.
# REPLY_TOKEN_TTL_SECONDS=3600
# WORKER_METRICS_PORT=9465
# Delivery retry backoff (ms). Defaults: 5000 base, 900000 (15 min) cap.
# DISPATCH_BACKOFF_BASE_MS=5000
# DISPATCH_BACKOFF_CAP_MS=900000
# WORKER_POLL_SECONDS=2

# Agent destinations (worker). The key is only needed if you create agent destinations.
# ANTHROPIC_API_KEY=
# AGENT_CONCURRENCY=1
# AGENT_BACKOFF_BASE_MS=15000
# AGENT_BACKOFF_CAP_MS=300000
# Tests and demos only. Posts a canned reply, no API call. Refused when NODE_ENV=production.
# RELAY_AGENT_RUNNER=fake

# Tests only. Defaults to the relay_test database in compose.
# TEST_DATABASE_URL=postgres://relay:relay@localhost:54329/relay_test
